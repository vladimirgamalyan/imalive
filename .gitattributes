# Normalize all text files to LF in the repository
* text=auto eol=lf

# Windows-only scripts must stay CRLF
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf

# Binary assets — never normalize or diff as text
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.pdf  binary
*.bin  binary
